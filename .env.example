DATABASE_URL=postgresql+psycopg://valhalla_freight:valhalla_freight@db:5432/valhalla_freight
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
# Backend-only encryption key for carrier/API credentials. Set once before production and keep stable.
INTEGRATION_SECRET_KEY=replace-with-a-separate-long-random-integration-secret
ACCESS_TOKEN_MINUTES=720
DEFAULT_ADMIN_EMAIL=admin@valhallafreight.local
DEFAULT_ADMIN_PASSWORD=Valhalla123!
# Google Maps Platform - enable Maps JavaScript API + Places API for Customer 360 address autocomplete
VITE_GOOGLE_MAPS_API_KEY=

# Carrier compliance document uploads
MAX_COMPLIANCE_DOCUMENT_MB=15

# Dayton Freight API - use a Dayton web account with Web Services / Developer Integration enabled
DAYTON_API_BASE_URL=https://api.daytonfreight.com
DAYTON_API_USERNAME=
DAYTON_API_PASSWORD=
DAYTON_API_ACCOUNT=
